# Arc mainnet (chain id 5042). REQUIRED — the process starts but neither
# board loop runs without this. Verified live 2026-09-16:
# https://rpc.blockdaemon.mainnet.arc.io works but PRUNES eth_getLogs history
# beyond ~300k blocks back (any fromBlock older than that fails outright).
ARC_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
ARC_RPC_TIMEOUT_MS=30000
# Optional second endpoint, tried once ARC_RPC_URL is exhausted (see rpc.ts).
# https://rpc.drpc.mainnet.arc.io has no pruning but caps a single
# eth_getLogs call to a 10k-block range on the free tier — redundancy against
# one provider being down, not a fix for either one's own limit.
ARC_RPC_URL_FALLBACK=https://rpc.drpc.mainnet.arc.io

# 6-decimal ERC-20 interface predeploy over Arc's native USDC balance. Do not
# point this at the native 18-decimal representation (address 0x0) — see
# src/arc/config.ts's naming note.
ARC_USDC=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
ARC_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
V3_MOVERS_TOPIC_ID=
V4_MOVERS_TOPIC_ID=
DANGER_ZONE_TOPIC_ID=

# Block explorer used for the token link on each board row. Verified live
# 2026-09-16 — arc-scan.io (the obvious guess) does not resolve at all;
# docs.arc-scan.org is the real one despite the odd subdomain.
ARC_EXPLORER_BASE=https://docs.arc-scan.org

# Opt-out arming — unset/blank means ON. Set to 0/false/off/no to stop a loop
# from starting at all.
ARC_V3_ENABLED=1
ARC_V4_ENABLED=1

# --- Signal strategy (REQUIRED, PRIVATE) ---
# No defaults in code and none committed here — set the real values only in
# your deployment's secret/variable store. If any key is missing or invalid,
# both board loops refuse to start and the log names the offending KEYS only
# (never values). See src/strategy.ts for validation rules.
STRATEGY_RSI_PERIOD=
STRATEGY_RSI_OVERSOLD=
STRATEGY_RSI_OVERBOUGHT=
# Candle width in blocks.
STRATEGY_BLOCKS_PER_CANDLE=
# Finalized candle closes kept per pool; must be >= STRATEGY_RSI_PERIOD.
STRATEGY_MAX_CLOSES=
# Rows below this market cap (or with an unknown cap) go to the Danger Zone.
STRATEGY_MIN_MARKET_CAP_USD=
# Window volume floor (USDC base units) for showing an RSI value; 0 = off.
STRATEGY_RSI_MIN_VOLUME_USDC=

# --- v3 board ---
MOVERS_TOP_N=5
MOVERS_POLL_SECONDS=60
MOVERS_MAX_LOOKBACK_BLOCKS=6000
MOVERS_MCAP_MAX_LOOKUPS=25
# How long a token's on-chain supply/decimals read is cached before re-check —
# a mintable token's supply can change, so this isn't cached forever.
MOVERS_SUPPLY_TTL_MS=3600000

# --- v4 board — separate knobs, NOT shared with the v3 ones above except
# V4_MOVERS_TOP_N, which falls back to MOVERS_TOP_N if unset. Poll interval
# and lookback window do NOT fall back to the v3 keys — leaving these unset means v4 uses its own defaults below, not v3's values.
V4_MOVERS_TOP_N=5
V4_MOVERS_POLL_SECONDS=60
V4_MOVERS_MAX_LOOKBACK_BLOCKS=6000
# How many incomplete v4 pool-registry entries (written before tickSpacing/
# hooks were captured) one cycle may re-read. 0 disables the repair.
V4_META_REPAIR_PER_CYCLE=25
# Wall-clock cap on that repair phase, so it can't outlast the poll interval.
V4_META_REPAIR_MAX_MS=20000
# How far back to search for a v4 pool's Initialize event. NOT unbounded —
# verified live 2026-09-16 that querying from block 1 always fails on this
# chain's RPC (see ARC_RPC_URL above). A pool initialized before this window
# can never be found this way; that's a real RPC limitation, not a bug this
# number fixes by being bigger.
V4_INITIALIZE_LOOKBACK_BLOCKS=250000

# --- Contract verification (Arcscan) ---
# Verified live 2026-09-16: this returns a real `verified` boolean for both
# the USDC predeploy and an ordinary ERC-20. Verification status only — not
# a heuristic risk scan (mint/blacklist/tax/proxy detection).
ARC_SCAN_API_BASE=https://api.arc-scan.org/v1
ARC_SCAN_TIMEOUT_MS=10000
# How long a verification verdict is cached. Long-lived: verification almost
# never flips false->true and essentially never reverts true->false.
MOVERS_VERIFICATION_TTL_MS=21600000

PORT=3000
LOG_LEVEL=info
