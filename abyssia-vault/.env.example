# Arc testnet (chain 5042002) RPC for fork tests. Leave unset to skip fork tests.
# NOTE: forge auto-loads `.env`, so copying this file to `.env` makes plain
# `forge test` hit the network (rate-limited RPC). Fork tests pin FORK_BLOCK.
# rpc.testnet.arc.network serves archive state but rate-limits aggressively
# and caps eth_getLogs at 100k blocks.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Arc mainnet (chain 5042) RPC for read-only fork tests against Uniswap's REAL
# deployment (nothing is broadcast). Leave unset to skip.
ARC_MAINNET_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io

# Ethereum Sepolia RPC for the Sepolia fork tests (test/fork/AbyssiaDeploy.Sepolia.t.sol)
# and the Sepolia deployment. Leave unset to skip the fork tests. The fork test is pinned to
# block 11,913,750, so it needs an RPC that serves old state (publicnode prunes it).
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# ---------------------------------------------------------------------------
# Deployment (script/DeployAbyssia.s.sol, script/TestPools.s.sol).
# Every value is required (no defaults in code). Never commit a filled-in copy:
# DEPLOYER_PRIVATE_KEY is a secret; pass it through the environment.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
# Governance: PROPOSER proposes and executes timelocked admin changes (the Safe on
# mainnet); GUARDIAN can tighten instantly and cancel timelocked proposals.
PROPOSER=
KEEPER=
GUARDIAN=
TREASURY=
TIMELOCK_DELAY=
VAULT_NAME=
VAULT_SYMBOL=
# Amounts in USDC base units (6 decimals); bps out of 10,000.
VAULT_MIN_DEPOSIT=
VAULT_MAX_TOTAL_ASSETS=
VAULT_MAX_CYCLE_MOVE_BPS=
VAULT_MAX_SWAP_SLIPPAGE_BPS=
# Memecoin class risk limits (VaultRegistry.ClassParams; hard caps enforced on-chain).
MEMECOIN_MAX_ALLOCATION_BPS=
MEMECOIN_MAX_CLASS_BPS=
MEMECOIN_ALLOWED_SHAPES=
MEMECOIN_MAX_RANGES=
MEMECOIN_MIN_WIDTH_TICKS=
MEMECOIN_MAX_WIDTH_TICKS=
MEMECOIN_STOP_LOSS_BPS=
MEMECOIN_REBALANCE_COOLDOWN=
MEMECOIN_MIN_POOL_LIQUIDITY=
# Optional: a token whose USDC 0.3% v3 and v4 pools to allowlist at deploy time
# (on Sepolia, the TMEME address printed by TestPools).
ALLOW_TOKEN=
VAULT_SALT=
# TestPools only: USDC (base units) seeded into each test pool.
SEED_USDC=
